# EmailJS Configuration
# Sign up at https://www.emailjs.com (free tier: 200 emails/month)
#
# Setup steps:
#   1. Create an account at emailjs.com
#   2. Add an Email Service (Gmail, Outlook, etc.) — note the Service ID
#   3. Create an Email Template — note the Template ID
#      Template variables used: {{from_name}}, {{from_email}}, {{phone}},
#                               {{service}}, {{date}}, {{message}}
#   4. Go to Account > API Keys — copy your Public Key
#   5. Copy this file to .env and fill in the values below

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
